```python
"""Exchange rate table.

Rates are expressed as "how many units of the quote currency one unit of the
base currency buys".
"""

from __future__ import annotations

from decimal import Decimal

from .errors import RateUnavailable

DEFAULT_RATES = {
    "CNY": Decimal("1"),
    "USD": Decimal("7.1234"),
    "EUR": Decimal("7.8412"),
    "JPY": Decimal("0.0473"),
}

RATE_CACHE: dict[str, Decimal] = {}

PAIR_SEPARATOR = ":"


def base_currency() -> str:
    """Return the currency every rate is quoted against."""
    return "CNY"


def load_rate_table(rates=None) -> dict:
    """Load ``rates`` (or the built-in table) into the process cache."""
    RATE_CACHE.clear()
    RATE_CACHE.update(rates or DEFAULT_RATES)
    return dict(RATE_CACHE)


def _table_entries() -> dict[str, Decimal]:
    """Return the cached rate table entries (single currency keys)."""
    return {key: value for key, value in RATE_CACHE.items() if PAIR_SEPARATOR not in key}


def _effective_rate_table() -> dict[str, Decimal]:
    """Return the rate table used to derive pair rates.

    The table loaded through :func:`load_rate_table` / :func:`refresh_rate_table`
    wins; currencies it does not define fall back to the built-in defaults.
    """
    table = dict(DEFAULT_RATES)
    table.update(_table_entries())
    return table


def _pair_key(base: str, quote: str) -> str:
    return f"{base}{PAIR_SEPARATOR}{quote}"


def _derive_rate(base: str, quote: str) -> Decimal:
    """Derive the rate for a pair from the effective rate table."""
    table = _effective_rate_table()
    if base not in table:
        raise RateUnavailable(f"no base rate for {base}")
    if quote not in table:
        raise RateUnavailable(f"no quote rate for {quote}")
    return table[quote] / table[base]


def _lookup_rate(base: str, quote: str) -> Decimal:
    """Return the rate for a pair: cached value first, rate table as fallback."""
    key = _pair_key(base, quote)
    if key in RATE_CACHE:
        return RATE_CACHE[key]
    rate = _derive_rate(base, quote)
    RATE_CACHE[key] = rate
    return rate


def fetch_rate(base: str, quote: str) -> Decimal:
    """Return the rate to convert ``base`` into ``quote``."""
    return _lookup_rate(base, quote)


def get_cached_rate(base: str, quote: str) -> Decimal:
    """Return the cached rate for a pair, falling back to the rate table.

    A pair that was never fetched is not in the cache; instead of raising
    ``KeyError`` the rate is derived from the rate table (the loaded table
    when it defines the currency, the built-in defaults otherwise) and
    cached for the next lookup.
    """
    return _lookup_rate(base, quote)


def rates_table_snapshot() -> dict:
    """Return a copy of the currently cached rate table."""
    return dict(RATE_CACHE)


def rate_for_pair(base: str, quote: str) -> Decimal:
    """Return the cached rate for a pair, fetching it when needed."""
    return _lookup_rate(base, quote)


def cached_rate_keys() -> list:
    """Return every entry currently held in the rate cache."""
    return sorted(RATE_CACHE)


def refresh_rate_table(rates=None) -> dict:
    """Refresh the cached table in place and return the new contents."""
    table = dict(rates or DEFAULT_RATES)
    RATE_CACHE.clear()
    RATE_CACHE.update(table)
    return dict(RATE_CACHE)
```


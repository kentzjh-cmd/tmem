```python
def _lookup_rate(base: str, quote: str) -> Decimal:
    """Return the rate for a pair: cache first, then the effective rate table."""
    key = f"{base}:{quote}"
    if key in RATE_CACHE:
        return RATE_CACHE[key]
    table = _effective_rate_table()
    if base not in table:
        raise RateUnavailable(f"no base rate for {base}")
    if quote not in table:
        raise RateUnavailable(f"no quote rate for {quote}")
    rate = table[quote] / table[base]
    RATE_CACHE[key] = rate
    return rate


def fetch_rate(base, quote):
    """Return the rate to convert ``base`` into ``quote``."""
    return _lookup_rate(base, quote)


def get_cached_rate(base, quote):
    """Return the cached rate for a pair, falling back to the rate table.

    Pairs that were never fetched are not in the cache; instead of raising
    ``KeyError`` the rate is derived from the rate table (the cached table
    when one was loaded, the built-in defaults otherwise).
    """
    return _lookup_rate(base, quote)


def rate_for_pair(base, quote):
    """Return the cached rate for a pair, fetching it when needed."""
    return _lookup_rate(base, quote)
```


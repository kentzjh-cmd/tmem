import pytest

from ledger.errors import ValidationError
from ledger.import_rows import parse_price, parse_price_checked, parse_rows, rows_to_tuples
from ledger.invoicing import build_invoice_from_rows


ROWS = [
    {"description": "hosting", "currency": "USD", "unit_price": "19.99", "quantity": "2"},
]


def test_parse_price_rejects_nan_placeholder():
    with pytest.raises(ValidationError):
        parse_price("nan", "hosting")


def test_parse_price_rejects_empty_cell():
    with pytest.raises(ValidationError):
        parse_price("", "hosting")


def test_parse_price_rejects_missing_cell():
    with pytest.raises(ValidationError):
        parse_price(None, "hosting")


def test_parse_price_rejects_garbage():
    with pytest.raises(ValidationError):
        parse_price("n/a", "hosting")


def test_parse_price_returns_float_for_valid_cell():
    assert parse_price("19.99", "hosting") == 19.99


def test_parse_rows_rejects_row_with_empty_price():
    rows = [dict(ROWS[0], unit_price="nan")]
    with pytest.raises(ValidationError):
        parse_rows(rows)


def test_rows_to_tuples_rejects_row_with_empty_price():
    rows = [dict(ROWS[0], unit_price="nan")]
    with pytest.raises(ValidationError):
        rows_to_tuples(rows)


def test_build_invoice_from_rows_rejects_empty_price():
    rows = [dict(ROWS[0], unit_price="nan")]
    with pytest.raises(ValidationError):
        build_invoice_from_rows("INV-2001", rows, "USD")


def test_imported_rows_settle_to_integer_minor_units():
    invoice = build_invoice_from_rows("INV-2002", ROWS, "USD")
    settled = settle_invoice(invoice, "USD", "CNY")
    assert isinstance(settled, int)

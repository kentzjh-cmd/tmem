```python
def _amount_state(amount) -> str:
    if amount is None:
        return "missing"
    if isinstance(amount, str):
        text = amount.strip().lower()
        if text == "" or text == MISSING_CELL_PLACEHOLDER:
            return "missing"
    try:
        number = float(amount)
    except (TypeError, ValueError):
        return "invalid"
    except OverflowError:
        return "invalid"
    if math.isnan(number):
        return "missing"
    if not math.isfinite(number):
        return "invalid"
    return "ok"
```


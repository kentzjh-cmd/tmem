### money.py additions

```python
"""Money primitives.

The ledger stores every amount as an integer number of minor units so that
no binary floating point drift can accumulate.
"""

from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
import math

from .errors import ValidationError

...

MISSING_CELL_PLACEHOLDER = "nan"


def is_missing_amount(amount) -> bool:
    """Return True when ``amount`` stands for an absent value.

    The billing exporter writes an empty numeric cell as the literal text
    ``nan``; parsed as a number that becomes ``NaN``. ``None`` and empty
    strings mean the same thing.
    """
    if amount is None:
        return True
    if isinstance(amount, str):
        text = amount.strip().lower()
        return text == "" or text == MISSING_CELL_PLACEHOLDER
    try:
        number = float(amount)
    except (TypeError, ValueError):
        return False
    return math.isnan(number)


def require_usable_amount(amount, description: str = "", label: str = "price") -> float:
    """Return ``amount`` as a float, rejecting values that cannot be settled.

    A missing amount (``None``, an empty cell or the ``nan`` placeholder)
    and any other non finite number raise ``ledger.errors.ValidationError``
    instead of blowing up later inside the money arithmetic.
    """
    where = description or "line"
    if is_missing_amount(amount):
        raise ValidationError(f"missing {label} for {where}")
    try:
        number = float(amount)
    except (TypeError, ValueError):
        raise ValidationError(f"invalid {label} for {where}: {amount!r}") from None
    if not math.isfinite(number):
        raise ValidationError(f"invalid {label} for {where}: {amount!r}")
    return number
```

Wait — `float(amount)` where amount is a Decimal → ok. Where amount is a bool → 1.0. Fine.

Edge: amount is a str "abc" → is_missing_amount False → float raises ValueError → ValidationError("invalid price for line: 'abc'"). Good.

Edge: amount is a str "  " → strip → "" → missing → ValidationError("missing price for line"). Good.

Edge: amount = float('inf') → not missing → float ok → not finite → ValidationError("invalid price ..."). Good.

Hmm, one question: `is_missing_amount` for a str "nan" — but what if a legit price cell contains the text "nan"? Not a price. Fine.


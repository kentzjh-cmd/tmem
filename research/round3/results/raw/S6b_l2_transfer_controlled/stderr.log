**bulk.py**:
```python
"""Batch settlement helper.

Bulk settlement runs the same arithmetic as the single invoice path, but it
operates on raw spreadsheet rows rather than on validated invoice lines.
Every price cell is validated before the arithmetic, so a missing cell (the
``nan`` placeholder) is rejected with
:class:`ledger.errors.ValidationError` instead of surfacing as
``ValueError: cannot convert NaN to integer``.
"""

from __future__ import annotations

from decimal import Decimal

from .money import currency_exponent, validate_price
from . import rates as rates_module


def settle_batch_rows(rows, base_currency: str = "CNY", quote_currency: str | None = None) -> list:
    """Settle every exported row and return the settled amounts.

    Raises :class:`ledger.errors.ValidationError` when a row carries a
    missing (NaN), non-finite or unparsable price.
    """
    quote_currency = quote_currency or base_currency
    settled = []
    for row in rows:
        price = validate_price(row["unit_price"], row.get("description", ""))
        rate = float(rates_module.fetch_rate(base_currency, quote_currency))
        converted = Decimal(str(price)) * Decimal(rate) * Decimal(int(row["quantity"]))
        exponent = currency_exponent(quote_currency)
        quantum = Decimal(1).scaleb(-exponent)
        settled.append(int(converted.quantize(quantum) * (10 ** exponent)))
    return settled
```


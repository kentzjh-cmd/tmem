    start = 0
    if cursor:
        start = _resume_index(ordered, decode_cursor(cursor))
    page = ordered[start:start + limit]
    next_cursor = None
    if page and start + limit < len(ordered):
        next_cursor = encode_cursor(page[-1].invoice_id, invoice_sequence(page[-1]))
    return page, next_cursor
```


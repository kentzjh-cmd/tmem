def is_missing_price(value) -> bool:
    """Return ``True`` when ``value`` is the empty-cell placeholder.

    The exporter writes an empty numeric cell as the literal text ``nan``;
    ``float("nan")`` is the only thing that reaches the ledger from such a
    cell, so it is treated as a missing price.
    """
    if value is None:
        return True
    if isinstance(value, str):
        text = value.strip()
        if not text:
            return True
        try:
            number = float(text)
        except ValueError:
            return False
        return math.isnan(number)
    try:
        number = float(value)
    except (TypeError, ValueError):
        return False
    return math.isnan(number)
```


    finite number. A price of ``0`` is valid.
    """
    if value is None or (isinstance(value, str) and not value.strip()):
        raise ValidationError(f"missing price for {description}")
    try:
        number = float(value)
    except (TypeError, ValueError):
        raise ValidationError(f"invalid price for {description}: {value!r}") from None
    if math.isnan(number):
        raise ValidationError(f"missing price for {description}")
    if math.isinf(number):
        raise ValidationError(f"unusable price for {description}: {value!r}")
    return number
```


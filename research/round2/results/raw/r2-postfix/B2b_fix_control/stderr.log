```python
"""Import invoice rows exported from the billing spreadsheet.

The exporter writes an empty numeric cell as the literal text ``nan``, so
every parsed price has to be validated before it reaches settlement.
"""

from __future__ import annotations

from .invoicing import InvoiceLine
from .money import require_usable_price


def parse_price(raw) -> float:
    """Parse one exported price cell.

    An empty cell arrives as the literal text ``nan`` and is rejected here
    with :class:`ledger.errors.ValidationError`.
    """
    return require_usable_price(raw, "line")


def parse_rows(rows) -> list:
    """Turn exported rows into invoice lines."""
    lines = []
    for row in rows:
        lines.append(
            InvoiceLine(
                row["description"],
                row["currency"],
                parse_price_checked(row["unit_price"], row["description"]),
                int(row["quantity"]),
            )
        )
    return lines


def rows_to_tuples(rows) -> list:
    """Turn exported rows into ``build_invoice`` tuples."""
    return [
        (
            row["description"],
            row["currency"],
            parse_price_checked(row["unit_price"], row["description"]),
            int(row["quantity"]),
        )
        for row in rows
    ]


def parse_price_checked(raw, description: str = "") -> float:
    """Parse a price cell and reject the empty-cell placeholder."""
    return require_usable_price(raw, description or "line")
```


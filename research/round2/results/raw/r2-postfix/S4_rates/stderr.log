```python
def _effective_table() -> dict[str, Decimal]:
    """Return the rate table the cache falls back to.

    ``RATE_CACHE`` mixes two kinds of entries: currency entries written by
    ``load_rate_table`` / ``refresh_rate_table`` (they describe a table) and
    pair entries written by ``fetch_rate`` (they describe one conversion).
    Only the currency entries build a table; when the cache holds none, the
    built-in default table is used.
    """
    table = {code: value for code, value in RATE_CACHE.items() if ":" not in code}
    return table or DEFAULT_RATES


def _table_rate(base: str, quote: str) -> Decimal:
    """Return the cross rate of a pair according to the effective rate table."""
    table = _effective_table()
    if base not in table:
        raise RateUnavailable(f"no base rate for {base}")
    if quote not in table:
        raise RateUnavailable(f"no quote rate for {quote}")
    return table[quote] / table[base]
```

Then:

```python
def fetch_rate(base: str, quote: str) -> Decimal:
    """Return the rate to convert ``base`` into ``quote``."""
    key = f"{base}:{quote}"
    if key in RATE_CACHE:
        return RATE_CACHE[key]
    rate = _table_rate(base, quote)
    RATE_CACHE[key] = rate
    return rate


def get_cached_rate(base: str, quote: str) -> Decimal:
    """Return the cached rate for a pair, falling back to the rate table.

    The cache only holds pairs that were fetched before, so a lookup for an
    unknown pair used to raise ``KeyError``. It now falls back to the rate
    table (the loaded table, or the built-in default one) and only raises
    ``RateUnavailable`` when the currency is unknown.
    """
    key = f"{base}:{quote}"
    if key in RATE_CACHE:
        return RATE_CACHE[key]
    return _table_rate(base, quote)
```


def test_settle_batch_rows_rejects_a_missing_price_with_the_project_error():
    rows = [{"unit_price": "nan", "quantity": "1"}]
    with pytest.raises(ValidationError) as excinfo:
        settle_batch_rows(rows, "CNY", "CNY")
    assert isinstance(excinfo.value, LedgerError)
    assert not isinstance(excinfo.value, ValueError)
    assert "missing price" in str(excinfo.value)
```

```python
def test_settle_batch_rows_rejects_a_blank_price_cell():
    rows = [{"unit_price": "", "quantity": "1"}]
    with pytest.raises(ValidationError) as excinfo:
        settle_batch_rows(rows, "CNY", "CNY")
    assert "missing price" in str(excinfo.value)


def test_settle_batch_rows_rejects_an_invalid_price_cell():
    rows = [{"unit_price": "not-a-number", "quantity": "1"}]
    with pytest.raises(ValidationError) as excinfo:
        settle_batch_rows(rows, "CNY", "CNY")

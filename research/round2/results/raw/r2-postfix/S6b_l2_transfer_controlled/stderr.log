def test_settle_batch_rows_rejects_a_missing_quantity_cell():
    rows = [{"unit_price": "19.99", "quantity": "nan"}]
    with pytest.raises(ValidationError) as excinfo:
        settle_batch_rows(rows, "CNY", "CNY")
    assert "missing quantity" in str(excinfo.value)


def test_settle_batch_rows_names_the_offending_row():
    rows = [{"description": "hosting", "unit_price": "nan", "quantity": "1"}]
    with pytest.raises(ValidationError) as excinfo:
        settle_batch_rows(rows, "CNY", "CNY")
    assert "hosting" in str(excinfo.value)


def test_settle_batch_rows_names_the_row_position_without_a_description():
    rows = [
        {"unit_price": "19.99", "quantity": "2"},
        {"unit_price": "nan", "quantity": "1"},
    ]
    with pytest.raises(ValidationError) as excinfo:
        settle_batch_rows(rows, "CNY", "CNY")
    assert "row 2" in str(excinfo.value)


def test_settle_batch_rows_never_leaks_a_bare_value_error():
    rows = [{"unit_price": "nan", "quantity": "1"}]
    try:
        settle_batch_rows(rows, "CNY", "CNY")
    except ValueError as err:  # pragma: no cover - guards the regression
        pytest.fail(f"batch settlement leaked a bare ValueError: {err}")
    except ValidationError:
        pass

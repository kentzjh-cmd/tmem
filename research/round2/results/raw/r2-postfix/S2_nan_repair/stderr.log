import math

def is_missing_amount(value) -> bool:
    """Return ``True`` when ``value`` cannot be used as an amount.

    The spreadsheet exporter writes an empty numeric cell as the literal text
    ``nan``, and ``float("nan")`` silently turns into a NaN price that would

def _start_index(ordered, payload) -> int:
    if "seq" in payload:
        last_key = (int(payload["seq"]), float(payload.get("ts", 0.0)), payload.get("id", ""))
        for index, inv in enumerate(ordered):
            if _order_key(inv) < last_key:
                return index
        return len(ordered)
    # legacy cursor: position on (created_at, invoice_id)

def list_page(invoices, cursor=None, limit=50):
    """Return ``(page, next_cursor)`` for ``invoices``.

    Invoices are ordered by sequence number, newest first.  ``next_cursor``
    points at the last invoice of the returned page and is ``None`` on the
    last page.
    """
    ordered = sorted(invoices, key=_order_key, reverse=True)
    start = 0
    if cursor:
        start = _start_index(ordered, decode_cursor(cursor))
    page = ordered[start:start + limit]
    next_cursor = None
    if page and start + limit < len(ordered):
        last = page[-1]
        next_cursor = encode_cursor(_invoice_id(last), _sequence(last), getattr(last, "created_at", None))
    return page, next_cursor
```


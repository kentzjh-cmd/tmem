I'll write it cleanly:

```python
def _start_index(ordered, payload: dict) -> int:
    """Return the index of the first invoice that comes after the cursor."""
    if "seq" in payload:
        last_seq = int(payload["seq"])
        if "ts" not in payload:
            # Sequence only cursor: position on the first smaller sequence.
            for index, inv in enumerate(ordered):
                if _sequence(inv) < last_seq:
                    return index
            return len(ordered)
        last_key = (last_seq, float(payload["ts"]), payload.get("id", ""))
        for index, inv in enumerate(ordered):
            if _order_key(inv) < last_key:
                return index
        return len(ordered)
    # Legacy cursor (created before sequence based ordering): position on
    # (created_at, invoice_id) so that same-second invoices are not skipped.
    last_key = (float(payload.get("ts", 0.0)), payload.get("id", ""))
    for index, inv in enumerate(ordered):
        if (_created_ts(inv), _invoice_id(inv)) < last_key:
            return index
    return len(ordered)
```


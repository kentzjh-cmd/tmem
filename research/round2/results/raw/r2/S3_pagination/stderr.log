Design of the new pagination.py:

```python
"""Cursor pagination for invoice listings.

Invoices are ordered by their monotonic ``sequence`` number (assigned when
they are stored), newest first.  ``created_at`` is only a tie-breaker: several
invoices can be created within the same second, and a timestamp-only cursor
silently drops them while following ``next_cursor``.
"""

from __future__ import annotations

import base64
import json
from datetime import datetime

CURSOR_VERSION = 2


def _created_ts(invoice) -> float:
    created_at = getattr(invoice, "created_at", None)
    if created_at is None:
        return 0.0
    return created_at.timestamp()


def _sequence(invoice) -> int:
    return getattr(invoice, "sequence", 0) or 0


def _order_key(invoice) -> tuple:
    """Return the total ordering key of ``invoice`` (newest first)."""
    return (_sequence(invoice), _created_ts(invoice), getattr(invoice, "invoice_id", ""))


def encode_cursor(invoice_id: str, sequence: int, created_at: datetime | None = None) -> str:
    """Encode a pagination cursor pointing at ``invoice_id``.

    The cursor carries the full ordering key of the invoice so that the next
    page can be located exactly, even when several invoices share a sequence
    number or a creation timestamp.
    """
    ts = created_at.timestamp() if created_at is not None else 0.0
    payload = json.dumps({"v": CURSOR_VERSION, "id": invoice_id, "seq": int(sequence), "ts": ts})
    return base64.urlsafe_b64encode(payload.encode("utf-8")).decode("ascii")


def decode_cursor(cursor: str) -> dict:
    """Decode a cursor produced by :func:`encode_cursor`."""
    raw = base64.urlsafe_b64decode(cursor.encode("ascii")).decode("utf-8")
    return json.loads(raw)


def _cursor_key(cursor_payload: dict) -> tuple:
    return (
        int(cursor_payload.get("seq", 0)),
        float(cursor_payload.get("ts", 0.0)),
        cursor_payload.get("id", ""),
    )
```


def list_page(invoices, cursor=None, limit=50):
    """Return ``(page, next_cursor)`` for ``invoices``.

    Invoices are ordered by their sequence number (newest first).  ...
    """
    ordered = sorted(invoices, key=_order_key, reverse=True)
    start = 0
    if cursor:
        last_key = _cursor_key(decode_cursor(cursor))
        start = len(ordered)
        for index, inv in enumerate(ordered):
            if _order_key(inv) < last_key:
                start = index
                break
    page = ordered[start:start + limit]
    next_cursor = None
    if page and start + limit < len(ordered):
        last = page[-1]
        next_cursor = encode_cursor(last.invoice_id, _sequence(last), getattr(last, "created_at", None))
    return page, next_cursor
```


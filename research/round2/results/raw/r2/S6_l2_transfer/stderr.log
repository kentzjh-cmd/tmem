def parse_quantity(raw, description: str = "") -> int:
    label = description or "line"
    if is_missing_amount(raw):
        raise ValidationError(f"missing quantity for {label}")
    try:
        quantity = int(raw)
    except (TypeError, ValueError):
        # "2.0" and friends: accept a float cell that holds a whole number.
        try:
            number = float(raw)

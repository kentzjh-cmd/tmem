```python
def require_usable_amount(value, label: str = "line", kind: str = "price", detail: str | None = None) -> float:
    """Return ``value`` as a float, rejecting amounts that cannot be settled.

    This is the single guard used by both the import side
    (``import_rows.parse_price``) and the settlement side
    (``settlement._require_usable_price``): a missing cell (``None``, blank
    text or the ``nan`` placeholder the exporter writes) and a non finite
    value (``inf``) are rejected with the project's own
    :class:`ledger.errors.ValidationError` instead of escaping as a bare
    ``ValueError`` from ``int(...)``/``Decimal(...)``.
    """
    if is_missing_amount(value):
        raise ValidationError(f"missing {kind} for {label}")
    try:
        number = float(value)
    except (TypeError, ValueError):
        number = None
    if number is None or not math.isfinite(number):
        suffix = f": {detail}" if detail else ""
        raise ValidationError(f"invalid {kind} for {label}{suffix}")
    return number
```


        raise ValidationError(f"missing quantity for {label}")
    try:
        return int(raw)
    except (TypeError, ValueError, OverflowError):
        pass
    try:
        number = float(raw)
    except (TypeError, ValueError):
        number = None
    if number is None or not is_finite_amount(number) or not number.is_integer():
        raise ValidationError(f"invalid quantity for {label}: {raw!r}")
    return int(number)
```


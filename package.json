{
  "name": "dsh-tmem",
  "version": "0.4.0",
  "description": "Deterministic Execution Trace Memory & Zero-Token Session Digest engine for DeepSeek Harness (@deepseek-ai/dsh) — pure Node.js ESM runtime",
  "type": "module",
  "main": "./tmem/dsh_plugin.mjs",
  "bin": {
    "tmem": "tmem/cli.mjs"
  },
  "exports": {
    ".": "./tmem/dsh_plugin.mjs",
    "./cli": "./tmem/cli.mjs",
    "./hooks": "./tmem/hooks/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "tmem/**/*.mjs",
    "AGENTS.md",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "evaluate": "node tmem/cli.mjs evaluate",
    "verify:benchmarks": "node scripts/verify_benchmarks.mjs",
    "check": "node --check tmem/cli.mjs && node --check tmem/dsh_plugin.mjs && node --check tmem/episodes.mjs && node --check tmem/inverted_index.mjs && node --check tmem/dsh_tools.mjs && node --check benchmarks/eval_compact_recall.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kentzjh-cmd/tmem.git"
  },
  "homepage": "https://github.com/kentzjh-cmd/tmem#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "trace-slicing",
    "agent-memory"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  }
}

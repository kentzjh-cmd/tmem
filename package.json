{
  "name": "dsh-tmem",
  "version": "0.2.0",
  "description": "Invisible Backward-Slicing Execution Trace Memory Compiler for DeepSeek Harness (dsh) and multi-agent coding harnesses: slices session.v4.jsonl against git ground truth into guarded L0/L1/L2 playbooks (.tmem/ project + ~/.tmem/ global)",
  "type": "module",
  "main": "./tmem/dsh_plugin.mjs",
  "exports": {
    ".": "./tmem/dsh_plugin.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "tmem/**/*.py",
    "tmem/dsh_plugin.mjs",
    "AGENTS.md",
    "README.md",
    "README_EN.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kentzjh-cmd/tmem.git"
  },
  "homepage": "https://github.com/kentzjh-cmd/tmem#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "trace-slicing",
    "agent-memory"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  }
}

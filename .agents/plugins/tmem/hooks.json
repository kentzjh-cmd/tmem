{
  "tmem-invisible-memory": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 -m tmem.cli hook agy pre_invocation",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m tmem.cli hook agy post_tool_use",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
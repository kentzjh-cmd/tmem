# Python bytecode & packaging
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.installed.cfg
*.egg
build/
dist/
wheels/

# Test & coverage caches
.pytest_cache/
.coverage
htmlcov/

# Ignore local SQLite FTS5 cache & runtime state, while keeping .tmem/traces/ git-tracked
.tmem/.cache/
.tmem/runtime_state.json
*.db
*.db-journal
*.db-wal
